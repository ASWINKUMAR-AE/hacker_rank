{
  "name": "hackerrank-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "Educational HackerRank Practice Assistant for Algorithms, SQL, Databases, React, Shell, and JS challenges",
  "main": "backend/src/server.ts",
  "scripts": {
    "start": "tsx backend/src/server.ts",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build:extension": "vite build --config extension/vite.config.ts && node -e \"const fs=require('fs'); fs.copyFileSync('extension/manifest.json', 'dist/extension/manifest.json'); if (fs.existsSync('extension/popup.html')) fs.copyFileSync('extension/popup.html', 'dist/extension/popup.html'); if (!fs.existsSync('dist/extension/icons')) fs.mkdirSync('dist/extension/icons', {recursive: true}); if (fs.existsSync('extension/icons/icon.svg')) fs.copyFileSync('extension/icons/icon.svg', 'dist/extension/icons/icon.svg');\"",
    "dev:extension": "vite build --watch --config extension/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "auto": "tsx backend/src/automation/cli.ts",
    "solve": "tsx backend/src/automation/cli.ts",
    "auto:algo": "tsx backend/src/automation/cli.ts --domain algo",
    "auto:db": "tsx backend/src/automation/cli.ts --domain databases",
    "auto:sql": "tsx backend/src/automation/cli.ts --domain sql",
    "auto:shell": "tsx backend/src/automation/cli.ts --domain shell",
    "auto:react": "tsx backend/src/automation/cli.ts --domain react",
    "auto:js": "tsx backend/src/automation/cli.ts --domain js",
    "auto:all": "tsx backend/src/automation/cli.ts --domain all",
    "auto:submit": "tsx backend/src/automation/cli.ts --auto-submit",
    "lint": "eslint backend extension --ext .ts,.tsx"
  },
  "keywords": [
    "hackerrank",
    "automation",
    "playwright",
    "algorithms-solver",
    "database-solver",
    "sql-solver",
    "react-solver",
    "shell-solver",
    "chrome-extension"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "node-sql-parser": "^5.3.3",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@babel/generator": "^7.26.3",
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.2",
    "@babel/types": "^7.26.3",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/chrome": "^0.0.280",
    "@types/cors": "^2.8.17",
    "@types/diff": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
