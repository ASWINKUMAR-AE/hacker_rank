{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["backend/src/*"],
      "@extension/*": ["extension/src/*"]
    }
  },
  "include": [
    "backend/**/*.ts",
    "extension/**/*.ts",
    "extension/**/*.tsx",
    "tests/**/*.ts"
  ]
}
