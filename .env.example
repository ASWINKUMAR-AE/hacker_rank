# Server Port
PORT=4000

# AI Provider Selection: openrouter | ollama | openai | gemini | local_heuristic
AI_PROVIDER=openrouter

# Privacy Setting: local_only (blocks external calls) | allow_cloud
PRIVACY_MODE=allow_cloud

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama Configuration (Default Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Browser Automation Settings
HEADLESS_BROWSER=false
USER_DATA_DIR=./.browser_data
HACKERRANK_BASE_URL=https://www.hackerrank.com
