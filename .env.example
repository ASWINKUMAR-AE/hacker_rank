# Server Port
PORT=4000

# AI Provider Selection: local_heuristic | ollama | openrouter | openai | gemini
AI_PROVIDER=local_heuristic

# Privacy Setting: local_only (blocks external calls) | allow_cloud
PRIVACY_MODE=local_only

# Ollama Configuration (Low-level / Lightweight Local AI Models: qwen2.5-coder:1.5b, deepseek-coder:1.3b, deepseek-coder:6.7b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# HackerRank Credentials (for full auto mode)
HACKERRANK_EMAIL=
HACKERRANK_PASSWORD=

# Browser Automation Settings
HEADLESS_BROWSER=false
USER_DATA_DIR=./.browser_data
HACKERRANK_BASE_URL=https://www.hackerrank.com
